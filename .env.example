# ===== AI 测试工作流平台 环境配置 =====
# 复制本文件为项目根 .env 后按需填写

# ---- 大模型 API（OpenAI 兼容，如 DeepSeek）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
# 如需代理（外网/内网），填写如 http://127.0.0.1:7890
LLM_PROXY=

# ---- 数据库（默认 SQLite 本地快速起；生产切 MySQL）----
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/ai_test_platform
DATABASE_URL=

# ---- 测试执行（复用 pytest-bdd 工具链，可被项目级 engine_config 覆盖）----
# 默认按仓库内 <repo>/pytest-bdd 推导；如测试工程不在仓库内，请显式填写以下三项
PYTEST_PROJECT_DIR=<repo>/pytest-bdd
PYTEST_PYTHON=<repo>/pytest-bdd/.venv/Scripts/python.exe
ALLURE_BIN=<repo>/pytest-bdd/tools/allure/bin/allure.bat

# ---- SMTP 邮件（评审通知，可空）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=1
