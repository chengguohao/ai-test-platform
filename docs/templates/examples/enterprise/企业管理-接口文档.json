          { "name": "email", "type": "string", "required": false, "length": "邮箱格式", "enum": null, "description": "邮箱" },
          { "name": "province", "type": "int", "required": false, "length": null, "enum": null, "description": "省份ID" },
          { "name": "provinceName", "type": "string", "required": false, "length": null, "enum": null, "description": "省份名称" },
          { "name": "city", "type": "int", "required": false, "length": null, "enum": null, "description": "城市ID" },
          { "name": "cityName", "type": "string", "required": false, "length": null, "enum": null, "description": "城市名称" },
          { "name": "district", "type": "int", "required": false, "length": null, "enum": null, "description": "区县ID" },
          { "name": "districtName", "type": "string", "required": false, "length": null, "enum": null, "description": "区县名称" },
