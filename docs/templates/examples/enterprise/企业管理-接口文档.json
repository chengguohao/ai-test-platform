        ]
      },
      "response": {
        "data_type": "null",
        "description": "编辑成功 data=null",
        "success_fields": [],
        "error_codes": [
          { "key": "param_error", "code": 40000, "message": "参数校验失败" },
          { "key": "enterprise_not_exist", "code": 20011, "message": "企业不存在或已删除" },
          { "key": "enterprise_name_duplicate", "code": 20010, "message": "企业名称重复" },
