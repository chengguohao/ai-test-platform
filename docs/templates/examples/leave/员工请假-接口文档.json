          { "name": "endDate", "type": "string", "required": false, "length": "yyyy-MM-dd", "enum": null, "description": "申请时间范围止" }
        ],
        "headers": [],
        "body": []
      },
      "response": {
        "data_type": "对象",
        "description": "分页结果，含 total、list",
        "success_fields": [
          { "name": "total", "type": "long", "description": "总条数" },
          { "name": "list", "type": "array<LeaveApplyVO>", "description": "请假记录，元素含 applyNo、employeeName、deptName、leaveTypeName、startTime、endTime、durationDays、status、createTime" }
        ],
        "error_codes": [
          { "key": "param_error", "code": 40000, "message": "分页参数非法或日期格式错误" },
          { "key": "not_login", "code": 40100, "message": "未登录" },
          { "key": "no_permission", "code": 40300, "message": "非人事专员角色调用" }
        ]
      },
      "business_codes": {}
    },

    {
      "id": "IF-09",
      "name": "请假时长统计",
      "role": "hr_admin",
      "method": "GET",
      "path": "/leave/admin/statistics",
      "summary": "人事专员按部门统计指定时间范围内已通过（status=1）申请的请假时长聚合值",
      "request": {
        "content_type": "application/json",
        "path_params": [],
        "query_params": [
          { "name": "startDate", "type": "string", "required": true, "length": "yyyy-MM-dd", "enum": null, "description": "统计开始日期" },
          { "name": "endDate", "type": "string", "required": true, "length": "yyyy-MM-dd", "enum": null, "description": "统计结束日期" }
        ],
        "headers": [],
        "body": []
      },
      "response": {
        "data_type": "数组",
        "description": "按部门聚合的统计列表",
        "success_fields": [
          { "name": "list", "type": "array<DeptStatVO>", "description": "元素含 deptName、totalDays、applyCount" }
        ],
        "error_codes": [
          { "key": "param_error", "code": 40000, "message": "参数缺失或日期格式错误" },
