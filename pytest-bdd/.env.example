# ===== SmartAdmin 项目环境变量 =====
# SmartAdmin 后端地址（与前端 http://localhost:8081 不同）
SA_BASE_URL=http://127.0.0.1:1024
# 登录用户名（问卷默认 admin）
SA_LOGIN_NAME=admin
# 登录密码：请填写问卷拿到的 admin 账号密码。留空时所有 smartadmin marker 的用例自动 SKIP。
SA_PASSWORD=
# 登录设备标识：1=PC（固定值）
SA_LOGIN_DEVICE=1
# ===== 多角色（RBAC）测试账号 =====
# 角色键 -> {loginName, password, device?}
#   admin=管理员（全部权限）、reporter=填报员（增改自己数据、只读其余）、auditor=审核员（只读审核）
# 不配置时仅 admin 生效，依赖 reporter/auditor 的用例自动 SKIP；账号需在 SmartAdmin 后台预置。
# SA_ROLES_JSON={"admin":{"loginName":"admin","password":"123456"},"reporter":{"loginName":"reporter01","password":"******"},"auditor":{"loginName":"auditor01","password":"******"}}